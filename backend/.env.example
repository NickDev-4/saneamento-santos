spring.mongodb.uri=mongodb://127.0.0.1:27018/saneamento_santos?replicaSet=rs0
spring.mongodb.database=saneamento_santos
MONGODB_AUTO_INDEX_CREATION=true
SANTOS_SERVICE_AREA_GEOJSON=./data/santos-service-area.geojson
FILES_STORAGE_DIRECTORY=./data/images
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=SaneamentoSantos/1.0
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Optional SMTP delivery. Password recovery stays disabled until all required
# fields and a reachable SMTP server are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
RECOVERY_EMAIL_FROM=
RECOVERY_FRONTEND_URL=http://127.0.0.1:5173
RECOVERY_TOKEN_LIFETIME_MINUTES=30

# Optional first-run seeding. Never put passwords in this example file.
SEED_CIDADAO_EMAIL=
SEED_CIDADAO_NAME=
SEED_CIDADAO_PASSWORD=
SEED_SABESP_EMAIL=
SEED_SABESP_NAME=
SEED_SABESP_PASSWORD=
SEED_PREFEITURA_EMAIL=
SEED_PREFEITURA_NAME=
SEED_PREFEITURA_PASSWORD=
CASE_TYPES_SEED_FILE=./data/case-types.json
